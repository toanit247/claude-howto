# Sao chép thành .env rồi điền giá trị thật. Không đưa .env vào Git.

# Môi trường web: staging (thử) hoặc production (thật)
APP_ENV=staging
PORT=3000
# Địa chỉ công khai của web, dùng cho canonical, sitemap, Open Graph
PUBLIC_BASE_URL=http://localhost:3000

# company: web công ty (khách lẻ, đại lý, CTV); alliance: cổng doanh nghiệp liên minh
SITE_KIND=company
BRAND_CONFIG=brand/wondertour.json

# xTravelOS — chỉ máy chủ web đọc các biến này
# Bản giả lập: http://localhost:4100. xTravelOS thử trên máy anh Toản: http://127.0.0.1:8766
XTRAVEL_API_URL=http://localhost:4100
XTRAVEL_API_KEY=dev-service-key-change-me-0001
XTRAVEL_WEBHOOK_SECRET=dev-webhook-secret-change-me-0001
# Máy chủ xTravelOS thật: web thử (APP_ENV=staging) từ chối khởi động nếu trỏ vào đây
XTRAVEL_PRODUCTION_API_HOST=api.xtravelos.vn

# Khóa ký cookie hồ sơ đại lý (chuỗi ngẫu nhiên dài)
COOKIE_SECRET=dev-cookie-secret-change-me-0001
# Chạy http://localhost thì đặt false; web thật luôn true
COOKIE_SECURE=false
# Số lớp proxy đứng trước web (Railway: 1)
TRUST_PROXY=1

# Tài khoản quản trị web (/quan-tri). Tạo ADMIN_PASSWORD_HASH bằng: node scripts/hash-password.mjs
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Tệp lưu cấu hình web; trên Railway gắn Volume vào thư mục data/
SETTINGS_FILE=data/site-settings.json

# Trợ lý AI tư vấn tour: có khóa thì gọi Claude, để trống thì chạy chế độ gợi ý cơ bản
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
