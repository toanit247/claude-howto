{
  "name": "wondertour-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web bán hàng WonderTour đấu nối xTravelOS (không có cơ sở dữ liệu nghiệp vụ)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/dev.ts",
    "dev:mock": "tsx watch mock-xtravelos/main.ts",
    "build": "vite build --outDir dist/client && vite build --ssr src/client/entry-server.tsx --outDir dist/server-entry && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "start:mock": "tsx mock-xtravelos/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude \"tests/contract/**\"",
    "test:e2e": "playwright test",
    "gen:types": "openapi-typescript \"${XTRAVEL_API_URL:-http://localhost:4100}/openapi.json\" -o src/shared/xtravelos-openapi.d.ts",
    "test:contract": "vitest run tests/contract"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify-json/solar": "^1.2.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "qrcode": "^1.5.4",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
